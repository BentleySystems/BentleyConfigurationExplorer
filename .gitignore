## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# Build outputs
[Bb]in/
[Oo]bj/
Publish/
.vs/
TestResults/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.lscache

# Logs and diagnostics
*.log
*.tlog
*.tmp
*.temp

# Package/build artifacts
*.nupkg
*.snupkg
*.msi
*.zip
*.7z
packages/

# Commercial/vendor binaries must not be committed
lib/

# Workspace exports / binary snapshots
*.wrk
*.bcf
*.backup_*
WorkspaceCFG_Backup_*/

# Private/local test corpora and generated debug output
MSDebug_Tests/
msdebug*.txt
*_msdebug.txt

# Python/local tooling artifacts
__pycache__/
*.py[cod]
.venv/
venv/

# OS files
.DS_Store
Thumbs.db
desktop.ini